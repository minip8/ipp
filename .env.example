# Copy to .env. Every service validates its own subset at boot and fails fast.
NODE_ENV=development

# --- data stores (docker compose) ---
DATABASE_URL=postgres://ipp:ipp@127.0.0.1:5432/ipp
REDIS_URL=redis://127.0.0.1:6379

# --- api ---
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-change-me
# X-Forwarded-For is believed only from these peers (rightmost untrusted hop wins). Next's rewrite
# passes a client-supplied X-Forwarded-For through unchanged, so in production put an edge proxy
# that appends the client address in front of Next and list Next + that proxy here.
TRUST_PROXY=true
TRUSTED_PROXIES=127.0.0.1,::1
# optional GitHub sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional Google sign-in (redirect URI: <WEB_ORIGIN>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI features (interviewer, assessment, short-answer grading) ---
# They run only on the API key each user saves in the app (account menu -> AI key), from
# Anthropic, OpenAI, Google Gemini or OpenRouter; the operator pays for no model usage. The API
# never reads ANTHROPIC_API_KEY / ANTHROPIC_KEY / OPENAI_API_KEY / GEMINI_API_KEY or any other
# provider key. (packages/interviewer/scripts/simulate.ts, a developer tool, still uses an
# Anthropic one from here.)
# ANTHROPIC_API_KEY=
# Default interviewer model per provider (users can pick another per interview). Empty = built-in.
INTERVIEWER_MODEL=claude-opus-5-5
INTERVIEWER_MODEL_OPENAI=
INTERVIEWER_MODEL_GEMINI=
INTERVIEWER_MODEL_OPENROUTER=
# Users' keys are stored in Redis only, encrypted (AES-256-GCM) under a key derived from this
# secret (32+ characters; openssl rand -hex 32). Empty = derived from BETTER_AUTH_SECRET.
# Changing whichever secret is used makes stored keys unreadable: users add them again.
AI_KEY_ENCRYPTION_SECRET=
# A saved key is deleted after this many hours without use (each use restarts the clock).
AI_KEY_TTL_HOURS=24
# Per user per day, on the user's own key: they bound a user's spend and stop the server being
# used as a relay.
AI_DAILY_MESSAGE_LIMIT=1500
# Per user per day; silent decisions and report assessments cost tokens without being messages.
AI_DAILY_INPUT_TOKEN_LIMIT=5000000
AI_DAILY_OUTPUT_TOKEN_LIMIT=500000

# --- web ---
NEXT_PUBLIC_WS_URL=ws://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# --- judge (runs on its own host in production; needs only Redis + the Docker socket) ---
JUDGE_CONCURRENCY=2
# runsc (gVisor) is mandatory when strangers can run code. runc is for local development only.
SANDBOX_RUNTIME=runc
JUDGE_ALLOW_INSECURE_RUNTIME=1

  "source": "class Solution:\n    def twoSum(self, nums: list[int], target: int) -> list[int]:\n        seen = {}\n        for i, x in enumerate(nums):\n            if target - x in seen:\n                return [seen[target - x], i]\n            seen[x] = i\n        return []\n\n\nif __name__ == \"__main__\":\n    print(Solution().twoSum([2, 7, 11, 15], 9))\n",

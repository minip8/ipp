# Copy to .env.prod on the app host. Generate each secret with:  openssl rand -hex 32
SITE_HOST=interview.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_JUDGE_PASSWORD=
BETTER_AUTH_SECRET=

# Private (VPC) address of this host; Redis is published only there, for the judge VM.
REDIS_BIND_IP=

# AI features run only on each user's own Anthropic API key (saved in the app); the server
# takes no Anthropic key of its own. Users' keys are kept in Redis, encrypted under a key derived
# from AI_KEY_ENCRYPTION_SECRET (or BETTER_AUTH_SECRET when empty). Rotating it discards them.
AI_KEY_ENCRYPTION_SECRET=
# Unused keys are deleted after this many hours.
AI_KEY_TTL_HOURS=24
INTERVIEWER_MODEL=claude-opus-5-5
AI_DAILY_MESSAGE_LIMIT=300
AI_DAILY_INPUT_TOKEN_LIMIT=5000000
AI_DAILY_OUTPUT_TOKEN_LIMIT=500000

# Optional GitHub sign-in (callback: https://<SITE_HOST>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google sign-in (redirect URI: https://<SITE_HOST>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
